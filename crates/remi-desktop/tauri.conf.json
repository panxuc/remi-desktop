{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remi",
  "version": "0.1.0",
  "identifier": "moe.anything.remi",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "pet",
        "title": "Remi",
        "width": 260,
        "height": 260,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"]
  }
}
