{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remi",
  "identifier": "moe.anything.remi",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "pet",
        "title": "Remi",
        "width": 260,
        "height": 260,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "msi", "nsis"],
    "publisher": "un-lock-able",
    "shortDescription": "A desktop pet that shows what your coding agent is doing.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
